#
# sdkconfig.defaults - RNode-HaLow (ESP32-S3-WROOM-1 N16R8)
#
# Target is set via `idf.py set-target esp32s3`; this file only covers
# hardware/network settings. Full configuration via `idf.py menuconfig`.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash: 16 MB, Quad I/O, 80 MHz ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM: 8 MB, Octal (WROOM-1 N16R8) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- lwIP / TCP ---
# High socket budget: each proxied request holds TWO sockets (one httpd
# client socket + one esp_http_client socket to the radio), and browsers
# open 6+ connections in parallel plus OS captive-portal probes. 24 was too
# tight and caused "Failed to create socket" / accept() failures. 48 with
# larger TCP mailboxes gives headroom on this PSRAM-rich target.
CONFIG_LWIP_TCP_ISN_HOOK=y
CONFIG_LWIP_MAX_SOCKETS=56
# Active TCP PCB pool (MEMP_NUM_TCP_PCB). Default 16 is too tight: httpd
# client sockets + esp_http_client sockets + halow_link + RNS proxy all share
# this pool. Bump to 32 so bursts of proxied requests don't exhaust it.
CONFIG_LWIP_MAX_ACTIVE_TCP=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_RECVMBOX_SIZE=24
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=24

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- BLE (NimBLE) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# BT controller on core 1 to isolate it from the WiFi task (core 0). Both
# radio stacks on the same core causes coex-arbitration latency spikes that
# lead to bcn_timeout when BLE + APSTA are simultaneously active. ESP32-S3
# has two cores; putting BT controller on core 1 gives the coex arbiter its
# own CPU budget so it can resolve RF conflicts without starving WiFi.
CONFIG_BT_CTRL_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
# Host task stack: 4096 (the default) is known-marginal; the GATT access
# callback adds call depth on top of NimBLE's own processing.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
# mbuf pools: a 250-509 byte notification needs 1-3 mbufs; the defaults
# (12 x 256) allowed only ~12 notifications in flight before
# BLE_HS_ENOMEM stalls. Doubling keeps bursts flowing at MTU 512.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=32
# Peripheral Preferred Connection Parameters in the GAP service (units:
# 1.25 ms): 40-80 ms interval, latency 0, 3 s supervision. Hints sane
# parameters to centrals (same range the firmware requests after
# encryption); required to be multiples-friendly for iOS (Apple QA1931).
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_MIN_CONN_INTERVAL=32
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_MAX_CONN_INTERVAL=64
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_SLAVE_LATENCY=0
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_SUPERVISION_TMO=300
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# --- WiFi / SoftAP ---
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=y

# --- HTTP server / client ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_HTTPD_WS_SUPPORT=n
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=n
